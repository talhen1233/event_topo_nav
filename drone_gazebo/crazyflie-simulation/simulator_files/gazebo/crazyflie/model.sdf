      <sensor name="height_lidar" type="gpu_lidar">
        <pose>0 0 -0.05 0 1.57 0</pose>
        <topic>/crazyflie/lidar/height</topic>
        <update_rate>50</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
