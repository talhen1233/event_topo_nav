<?xml version="1.0" ?>

<sdf version="1.8">
  <model name="crazyflie">
    <link name="crazyflie/body">
      <pose> 0 0 17.425E-3 0 0 0</pose>
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>16.571710E-06</ixx>
          <iyy>16.655602E-06</iyy>
          <izz>29.261652E-06</izz>
          <ixy>0.830806E-06</ixy>
          <ixz>0.718277E-06</ixz>
          <iyz>1.800197E-06</iyz>
        </inertia>
      </inertial>

      <visual name="crazyflie/body_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/cf2_assembly.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <topic>/crazyflie/imu/data</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <pose>0 0 0 0 0 0</pose>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>7.5e-06</bias_mean>
                <bias_stddev>8e-07</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>7.5e-06</bias_mean>
                <bias_stddev>8e-07</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>7.5e-06</bias_mean>
                <bias_stddev>8e-07</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <light name="front_spotlight" type="spot">
        <pose>0.1 0 0 0 0 0</pose>
        <diffuse>1.0 1.0 1.0 1.0</diffuse>
        <specular>1.0 1.0 1.0 1.0</specular>
        <attenuation>
          <range>50</range>
          <constant>0.1</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
        </attenuation>
        <direction>1 0 0</direction>
        <spot>
          <inner_angle>0.5</inner_angle>
          <outer_angle>1.0</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>true</cast_shadows>
        <visualize>false</visualize>
      </light>

      <light name="bottom_spotlight" type="spot">
        <pose>0 0 -0.05 0 1.57 0</pose>
        <diffuse>1 1 1 1</diffuse>
        <specular>1 1 1 1</specular>
        <attenuation>
          <range>30</range>
          <constant>0.1</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
        </attenuation>
        <direction>1 0 0</direction>
        <spot>
          <inner_angle>1.2</inner_angle>
          <outer_angle>1.6</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>true</cast_shadows>
        <visualize>false</visualize>
      </light>

      <sensor name="bottom_camera" type="camera">
        <pose>0 0 -0.05 0 1.57 0</pose>
        <camera>

          <horizontal_fov>1.7977</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <lens>

            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>

            <intrinsics>
              <fx>253.7</fx>
              <fy>253.7</fy>
              <cx>320.0</cx>
              <cy>200.0</cy>
              <skew>0.0</skew>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/crazyflie/camera/bottom</topic>
        <ignition_frame_id>bottom_camera_link</ignition_frame_id>
      </sensor>

      <sensor name="third_person_camera" type="camera">

        <pose>-0.8 0 0.35 0 0.3 0</pose>
        <camera>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/crazyflie/camera/third_person</topic>
        <ignition_frame_id>third_person_camera_link</ignition_frame_id>
      </sensor>

      <sensor name="depth_front" type="gpu_lidar">
        <pose>0.1 0 0 0 0 0</pose>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>10.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
          <visibility_mask>4294967295</visibility_mask>
        </ray>
        <always_on>true</always_on>
        <topic>/crazyflie/depth_camera/front</topic>
        <visualize>false</visualize>
        <gz_frame_id>front_depth_link</gz_frame_id>
      </sensor>

      <sensor name="depth_back" type="gpu_lidar">
        <pose>-0.1 0 0 0 0 3.14159</pose>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>8</samples>
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </horizontal>
            <vertical>
